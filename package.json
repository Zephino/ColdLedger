{
  "name": "cold-ledger",
  "version": "0.1.7",
  "private": true,
  "description": "Cold Ledger: a turn-based colony survival game.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win portable",
    "export:godot": "vite-node tools/export_godot.ts"
  },
  "build": {
    "appId": "local.coldledger.game",
    "productName": "Cold Ledger",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
